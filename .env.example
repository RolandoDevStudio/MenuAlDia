# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Landing CRO → WhatsApp de ventas
NEXT_PUBLIC_SALES_WHATSAPP=5215512345678

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com

# Cron
CRON_SECRET=your_cron_secret

# WhatsApp Cloud API (Meta) — Embedded Signup + webhook
# Generate ENCRYPTION_KEY: openssl rand -hex 32
# Encrypt access token for DB (ops fallback): npm run wa:encrypt-token -- "EAA..."
ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
# From Meta Developers → WhatsApp → Embedded Signup → Configuration ID
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=your_random_verify_token
# WHATSAPP_GRAPH_VERSION=v21.0
# Meta App settings: Allowed Domains + Valid OAuth Redirect URIs = NEXT_PUBLIC_APP_URL
# Webhook callback: {NEXT_PUBLIC_APP_URL}/api/whatsapp/webhook (subscribe to messages)

# AI — Vertex AI (preferred; uses GCP credit). GEMINI_API_KEY is deprecated.
# GEMINI_API_KEY=your_gemini_api_key

# Google Cloud / Vertex AI
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
# Image model (Imagen 3 shut down). Default in code: gemini-2.5-flash-image
# GCP_IMAGEN_MODEL=gemini-2.5-flash-image
# Alternatives: gemini-3.1-flash-image / gemini-3-pro-image (if enabled on your project)